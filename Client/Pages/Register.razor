@page "/register"
@using global::Client.Services
@using global::Shared
@inject IAuthServiceClient _authServiceClient 


<PageTitle>Register</PageTitle>

<h3>Register</h3>

@if (int.TryParse(mensagem, out int valor) && valor == 1 && !String.IsNullOrWhiteSpace(mensagem))
{
    <div class="alert alert-info mt-3">Utilizador Adicionado Com Successo</div>
} else if(valor != 1 && !string.IsNullOrWhiteSpace(mensagem)){
    <div class="alert alert-info mt-3">Nao foi possivel adicionar Utilizador</div>
}

<EditForm Model="user" OnValidSubmit="HandleRegistration" @key="formKey">
    <DataAnnotationsValidator/>
    <div class="mb-3">
        <label for="email">Email</label>
        <InputText id="email" @bind-Value="user.Email" class="form-control"></InputText>
        <ValidationMessage For="@(() => user.Email)"/>
    </div>
    <div class="mb-3">
        <label for="password">Password</label>
        <InputText id="password" type="password" @bind-Value="user.Password" class="form-control"></InputText>
        <ValidationMessage For="@(() => user.Password)"/>
    </div>
    <div class="mb-3">
        <label for="confirmPassword">Confirm Password</label>
        <InputText id="confirmPassword" @bind-Value="user.ConfirmPassword" class="form-control" type="password"></InputText>
        <ValidationMessage For="@(() => user.ConfirmPassword)"/>
    </div>
    <button type="submit" class="btn btn-primary"> Register</button>
</EditForm>


@code{
    RegisterDTO user = new RegisterDTO();
    string mensagem = "";
    private string formKey = Guid.NewGuid().ToString();


    public async Task HandleRegistration(){
       mensagem = await _authServiceClient.Register(user);

       if(int.TryParse(mensagem, out int valor)){
            user = new RegisterDTO();
            formKey = Guid.NewGuid().ToString();
       }
    }
}   
    
