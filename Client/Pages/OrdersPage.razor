@page "/orders"
@using global::Client.Services
@using global::Shared
@inject IOrderServiceClient _orderService

<h3>Orders</h3>

@if (listaOrders == null)
{
    <span>Loading Orders...</span>
}
else if (listaOrders.Count <= 0)
{
    <span>You have no Orders</span>
}
else
{
    @foreach (var order in listaOrders)
    {
        <div class="container">
            <div class="image-wrapper">
                <img src="@order.ProdutoImgUrl" class="image" />
            </div>
            <div class="details">
                <h4>@order.Produto</h4>
                <span>@order.Date.ToShortDateString()</span>
                <a href="orders/@order.Id">Show More...</a>
            </div>
            <div class="order-price">@order.TotalPrice.ToString("C")</div>
        </div>
    }
}

@code {
    List<OrderFinalDTO> listaOrders = new List<OrderFinalDTO>();

    protected override async Task OnInitializedAsync()
    {
        //sumario de orders
        listaOrders = await _orderService.GetOrders();
    }
}

<style>
    h3 {
        font-size: 24px;
        color: #2c3e50;
        margin-bottom: 20px;
    }

    .container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background-color: #f9f9f9;
        border-radius: 10px;
        padding: 16px;
        margin: 12px 0;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s ease-in-out;
    }

    .container:hover {
        transform: scale(1.01);
    }

    .image-wrapper {
        flex: 0 0 100px;
        margin-right: 16px;
    }

    .image {
        width: 100px;
        height: 100px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #ccc;
    }

    .details {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .details h4 {
        font-size: 1.1rem;
        margin: 0;
        color: #333;
    }

    .details span {
        font-size: 0.9rem;
        color: #777;
    }

    .details a {
        font-size: 0.85rem;
        color: #0078D7;
        text-decoration: none;
    }

    .details a:hover {
        text-decoration: underline;
    }

    .order-price {
        font-weight: bold;
        font-size: 1.2rem;
        color: #61a972;
        margin-left: 16px;
        white-space: nowrap;
    }
</style>
