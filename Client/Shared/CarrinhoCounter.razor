@using Blazored.LocalStorage
@using Server.Services
@using global::Shared
@inject ICartServiceClient _ICartService
@inject ILocalStorageService _LocalStorageService

@inject ICartServiceClient _cartService
@inject ILocalStorageService _localStorage

<div class="cart-container">
    <a href="cart" class="btn btn-info d-flex align-items-center justify-content-center">
        <i class="oi oi-cart me-2"></i>
        <span>@valorTotalQuantidae</span>
    </a>
</div>

@code {
    int valorTotalQuantidae = 0;

    protected override async Task OnInitializedAsync()
    {
        // Primeiro carregamento
        valorTotalQuantidae = await _localStorage.GetItemAsync<int>("cartItemsCount");

        // Escuta alterações futuras
        _cartService.OnChange += AtualizarContador;
    }

    private async void AtualizarContador()
    {
        valorTotalQuantidae = await _localStorage.GetItemAsync<int>("cartItemsCount");
        StateHasChanged(); // força renderização
    }

    // Limpando inscrição do evento se necessário (bom pra produção)
    public void Dispose()
    {
        _cartService.OnChange -= AtualizarContador;
    }
}


