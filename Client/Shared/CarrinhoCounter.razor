@using Blazored.LocalStorage
@using Server.Services
@using global::Shared
@inject ICartServiceClient _ICartService
@inject ILocalStorageService _LocalStorageService

<div class="cart-container">
    <a href="cart" class="btn btn-info d-flex align-items-center justify-content-center">
        <i class="oi oi-cart me-2"></i>
        <span>@valorTotalQuantidae</span>
    </a>
</div>


@code {

    int valorTotalQuantidae;

    private async Task<int> GetCartItemsCount()
    {
        var cart = await _ICartService.GetCartProductsDto();
        var total = cart.Sum(p => p.Quantidade);

        return total;
    }

    protected override async Task OnInitializedAsync()
    {
        //sempre que CartService fizer OnChange?.Invoke(), chama StateHasChanged() aqui"
        valorTotalQuantidae = await GetCartItemsCount();

        //Adiciona essa função anônima à lista de ações que devem ser executadas quando OnChange?.Invoke() for chamado.
        _ICartService.OnChange += async () =>
        {
            valorTotalQuantidae = await GetCartItemsCount();
            StateHasChanged();
        };
    }

}
